{
  "name": "pdf-to-summary-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && vitest run",
    "format": "prettier --write src tests *.ts",
    "format:check": "prettier --check src tests *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "^5.0.1"
  }
}
