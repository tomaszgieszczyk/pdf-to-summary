server {
    listen ${APP_PORT};
    server_name _;
    root /usr/share/nginx/html;
    location ~ \.mjs$ {
        types { application/javascript mjs; }
        try_files $uri =404;
    }
    location /${APP}/assets/ { try_files $uri =404; }
    location /${APP}/ { try_files $uri $uri/ /${APP}/index.html; }
    location / { return 404; }
}
